@page "/machines/edit/{MachineId:int}"
@using DigitalWorldOnline.Commons.DTOs.Assets
@using MudBlazor

<PageTitle>Edit Machine - Open Digimon Masters Online</PageTitle>

<MudPaper Style="overflow-x: hidden; padding: 20px; margin-top: 15px;">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h4">Edit Machine (Gotcha)</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/machines"
                   Color="Color.Default">
            Back to Machines
        </MudButton>
    </MudStack>

    @if (Loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (Machine == null)
    {
        <MudAlert Severity="Severity.Error">Machine not found</MudAlert>
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <!-- Machine Info Tab -->
            <MudTabPanel Text="Machine Info" Icon="@Icons.Material.Filled.Settings">
                <EditForm Model="@Machine" OnValidSubmit="async () => await SaveMachine()">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.h6" Color="Color.Primary">Basic Information</MudText>
                            <MudDivider Class="mb-4" />
                        </MudItem>

                        <MudItem xs="6" sm="4">
                            <MudTextField @bind-Value="Machine.GotchaId"
                                          Label="Machine ID"
                                          Variant="Variant.Outlined"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="6" sm="4">
                            <MudNumericField T="int"
                                             Label="NPC ID"
                                             Variant="Variant.Outlined"
                                             Value="@Machine.NpcId"
                                             ValueChanged="@(async (int value) => { Machine.NpcId = value; await InvokeAsync(StateHasChanged); })" />
                        </MudItem>

                        <MudItem xs="6" sm="4">
                            <MudNumericField T="short"
                                             Label="Rare Item Chance (%)"
                                             Variant="Variant.Outlined"
                                             Min="0" Max="100"
                                             Immediate="true"
                                             Value="@Machine.Chance"
                                             ValueChanged="@(async (short value) => { Machine.Chance = value; await InvokeAsync(StateHasChanged); })" />
                        </MudItem>

                        <MudItem xs="6" sm="4">
                            <MudCheckBox @bind-Checked="Machine.Active"
                                         Label="Active Machine"
                                         Color="Color.Primary" />
                        </MudItem>

                        <MudItem xs="6" sm="4">
                            <MudNumericField T="short"
                                             Label="Limit"
                                             Variant="Variant.Outlined"
                                             Value="@Machine.Limit"
                                             ValueChanged="@(async (short value) => { Machine.Limit = value; await InvokeAsync(StateHasChanged); })" />
                        </MudItem>

                        <MudItem xs="6" sm="4">
                            <MudNumericField T="short"
                                             Label="Min Level"
                                             Variant="Variant.Outlined"
                                             Value="@Machine.MinLv"
                                             ValueChanged="@(async (short value) => { Machine.MinLv = value; await InvokeAsync(StateHasChanged); })" />
                        </MudItem>

                        <MudItem xs="6" sm="4">
                            <MudNumericField T="short"
                                             Label="Max Level"
                                             Variant="Variant.Outlined"
                                             Value="@Machine.MaxLv"
                                             ValueChanged="@(async (short value) => { Machine.MaxLv = value; await InvokeAsync(StateHasChanged); })" />
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end mt-4">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Submit"
                                       Disabled="@Saving">
                                @if (Saving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Saving...</MudText>
                                }
                                else
                                {
                                    <MudText>Save Machine</MudText>
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </EditForm>
            </MudTabPanel>

            <!-- Normal Items Tab -->
            <MudTabPanel Text="Normal Items" Icon="@Icons.Material.Filled.List">
                <MudGrid>
                    <MudItem xs="12" Class="mb-4">
                        <MudStack Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddNewNormalItem">
                                Add New Normal Item
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="async () => await SaveMachine()"
                                       Disabled="@Saving">
                                Save All
                            </MudButton>
                        </MudStack>
                    </MudItem>

                    @foreach (var item in Machine.Items)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Style="margin-bottom: 20px;">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">@item.Name</MudText>

                                    <MudNumericField T="int"
                                                     Label="Item ID"
                                                     Variant="Variant.Outlined"
                                                     Immediate="true"
                                                     Value="@item.ItemId"
                                                     ValueChanged="@(async (int value) => { item.ItemId = value; await InvokeAsync(StateHasChanged); })" />

                                    <MudNumericField T="int"
                                                     Label="Item Count"
                                                     Variant="Variant.Outlined"
                                                     Immediate="true"
                                                     Value="@item.ItemCount"
                                                     ValueChanged="@(async (int value) => { item.ItemCount = value; await InvokeAsync(StateHasChanged); })" />

                                    <MudNumericField T="int"
                                                     Label="Initial Quantity"
                                                     Variant="Variant.Outlined"
                                                     Immediate="true"
                                                     Value="@item.InitialQuanty"
                                                     ValueChanged="@(async (int value) => { item.InitialQuanty = value; await InvokeAsync(StateHasChanged); })" />

                                    <MudNumericField T="int"
                                                     Label="Current Quantity"
                                                     Variant="Variant.Outlined"
                                                     Immediate="true"
                                                     Value="@item.Quanty"
                                                     ValueChanged="@(async (int value) => { item.Quanty = value; await InvokeAsync(StateHasChanged); })" />
                                </MudCardContent>

                                <MudCardActions Class="d-flex justify-between">
                                    <MudButton Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.Save"
                                               OnClick="async () => await SaveMachine()"
                                               Disabled="@Saving">
                                        Save
                                    </MudButton>

                                    <MudButton Color="Color.Error"
                                               Variant="Variant.Text"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               OnClick="() => RemoveNormalItem(item)">
                                        Remove
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            <!-- Rare Items Tab -->
            <MudTabPanel Text="Rare Items" Icon="@Icons.Material.Filled.Star">
                <MudGrid>
                    <MudItem xs="12" Class="mb-4">
                        <MudStack Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddNewRareItem">
                                Add New Rare Item
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="async () => await SaveMachine()"
                                       Disabled="@Saving">
                                Save All
                            </MudButton>
                        </MudStack>
                    </MudItem>

                    @foreach (var rareItem in Machine.RareItems)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Style="margin-bottom: 20px;">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">@rareItem.Name</MudText>

                                    <MudNumericField T="int"
                                                     Label="Item ID"
                                                     Variant="Variant.Outlined"
                                                     Immediate="true"
                                                     Value="@rareItem.RareItem"
                                                     ValueChanged="@(async (int value) => { rareItem.RareItem = value; await InvokeAsync(StateHasChanged); })" />

                                    <MudNumericField T="short"
                                                     Label="Quantity"
                                                     Variant="Variant.Outlined"
                                                     Immediate="true"
                                                     Value="@rareItem.RareItemCnt"
                                                     ValueChanged="@(async (short value) => { rareItem.RareItemCnt = value; await InvokeAsync(StateHasChanged); })" />

                                    <MudNumericField T="short"
                                                     Label="Give Quantity"
                                                     Variant="Variant.Outlined"
                                                     Immediate="true"
                                                     Value="@rareItem.RareItemGive"
                                                     ValueChanged="@(async (short value) => { rareItem.RareItemGive = value; await InvokeAsync(StateHasChanged); })" />
                                </MudCardContent>

                                <MudCardActions Class="d-flex justify-between">
                                    <MudButton Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.Save"
                                               OnClick="async () => await SaveMachine()"
                                               Disabled="@Saving">
                                        Save
                                    </MudButton>

                                    <MudButton Color="Color.Error"
                                               Variant="Variant.Text"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               OnClick="() => RemoveRareItem(rareItem)">
                                        Remove
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    }
    </MudPaper>