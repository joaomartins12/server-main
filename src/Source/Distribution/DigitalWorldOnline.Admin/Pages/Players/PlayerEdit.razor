@page "/players/edit/{PlayerId:long}"
@using DigitalWorldOnline.Commons.ViewModel.Players;
@using DigitalWorldOnline.Commons.Enums;
@using DigitalWorldOnline.Commons.Enums.Character;
@using DigitalWorldOnline.Commons.DTOs.Digimon;

<PageTitle>Edit Player - Open Digimon Masters Online</PageTitle>

<MudPaper Style="overflow-x: hidden;
        padding: 20px;
        margin-top: 15px;">
    <Loader Loading="@Loading">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4">Edit Player</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="/players"
                       Color="Color.Default">
                Back to Players
            </MudButton>
        </MudStack>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">

            <!-- Character Information Tab -->
            <MudTabPanel Text="Character Info" Icon="@Icons.Material.Filled.Person">
                @if (Player != null)
                {
                    <EditForm Model="@Player" OnValidSubmit="SavePlayer">
                        <MudGrid>
                            <!-- Basic Information -->
                            <MudItem xs="12">
                                <MudText Typo="Typo.h6" Color="Color.Primary">Basic Information</MudText>
                                <MudDivider Class="mb-4" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudTextField @bind-Value="Player.Name"
                                              Label="Player Name"
                                              Required="true"
                                              RequiredError="Player name is required"
                                              Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="byte" @bind-Value="Player.Level"
                                                 Label="Level"
                                                 Min="1"
                                                 Max="120"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="long" @bind-Value="Player.CurrentExperience"
                                                 Label="Current Experience"
                                                 Min="0"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudSelect @bind-Value="Player.Model"
                                           Label="Character Model"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem Value="CharacterModelEnum.MarcusDamon">Marcus Damon</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.ThomasNorstein">Thomas Norstein</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.YoshinoFujieda">Yoshino Fujieda</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.KeenanKrier">Keenan Krier</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.TaiKamiya">Tai Kamiya</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.MimiTachikawa">Mimi Tachikawa</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.MattIshida">Matt Ishida</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.TakeruaKaishi">Takeru Kaishi</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.HikariKamiya">Hikari Kamiya</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.SoraTakenoushi">Sora Takenoushi</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.IzzyIzumi">Izzy Izumi</MudSelectItem>
                                    <MudSelectItem Value="CharacterModelEnum.JoeKido">Joe Kido</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="short" @bind-Value="Player.Size"
                                                 Label="Character Size"
                                                 Min="1000"
                                                 Max="20000"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudTextField Value="@Player.Position.ToString()"
                                              Label="Character Position"
                                              Variant="Variant.Outlined"
                                              ReadOnly="true" />
                            </MudItem>

                            <!-- Status & Location -->
                            <MudItem xs="12">
                                <MudText Typo="Typo.h6" Color="Color.Primary">Status & Location</MudText>
                                <MudDivider Class="mb-4" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudSelect @bind-Value="Player.State"
                                           Label="Connection State"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem Value="CharacterStateEnum.Disconnected">Disconnected</MudSelectItem>
                                    <MudSelectItem Value="CharacterStateEnum.Connected">Connected</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudSelect @bind-Value="Player.EventState"
                                           Label="Event State"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem Value="CharacterEventStateEnum.None">None</MudSelectItem>
                                    <MudSelectItem Value="CharacterEventStateEnum.Entering">Entering</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="byte" @bind-Value="Player.Channel"
                                                 Label="Channel"
                                                 Min="1"
                                                 Max="10"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="int" @bind-Value="Player.MapId"
                                                 Label="Map ID"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <!-- Resources -->
                            <MudItem xs="12">
                                <MudText Typo="Typo.h6" Color="Color.Primary">Resources & Stats</MudText>
                                <MudDivider Class="mb-4" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="int" @bind-Value="Player.CurrentHp"
                                                 Label="Current HP"
                                                 Min="0"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="int" @bind-Value="Player.CurrentDs"
                                                 Label="Current DS"
                                                 Min="0"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="int" @bind-Value="Player.XGauge"
                                                 Label="X Gauge"
                                                 Min="0"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="short" @bind-Value="Player.XCrystals"
                                                 Label="X Crystals"
                                                 Min="0"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="short" @bind-Value="Player.CurrentTitle"
                                                 Label="Current Title ID"
                                                 Min="0"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudNumericField T="byte" @bind-Value="Player.DigimonSlots"
                                                 Label="Digimon Slots"
                                                 Min="1"
                                                 Max="5"
                                                 Variant="Variant.Outlined" />
                            </MudItem>

                            <!-- Account Information (Read-only) -->
                            <MudItem xs="12">
                                <MudText Typo="Typo.h6" Color="Color.Primary">Account Information</MudText>
                                <MudDivider Class="mb-4" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudTextField Value="@Player.Id.ToString()"
                                              Label="Character ID"
                                              Variant="Variant.Outlined"
                                              ReadOnly="true" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudTextField Value="@Player.AccountId.ToString()"
                                              Label="Account ID"
                                              Variant="Variant.Outlined"
                                              ReadOnly="true" />
                            </MudItem>

                            <MudItem xs="6" xl="4" sm="6">
                                <MudTextField Value="@Player.CreateDate.ToString("dd/MM/yyyy HH:mm")"
                                              Label="Create Date"
                                              Variant="Variant.Outlined"
                                              ReadOnly="true" />
                            </MudItem>

                            <!-- Action Buttons -->
                            <MudItem xs="12" Class="d-flex justify-end">
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Default"
                                               Href="/players">
                                        Cancel
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               ButtonType="ButtonType.Submit"
                                               Disabled="@Saving">
                                        @if (Saving)
                                        {
                                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                            <MudText Class="ms-2">Saving...</MudText>
                                        }
                                        else
                                        {
                                            <MudText>Save Changes</MudText>
                                        }
                                    </MudButton>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                }
                else
                {
                    <MudAlert Severity="Severity.Error">
                        Player not found or failed to load player data.
                    </MudAlert>
                }
            </MudTabPanel>

            <MudTabPanel Text="Progress" Icon="@Icons.Material.Filled.Timeline">
                @if (Player?.CharacterProgresses != null && Player.CharacterProgresses.Any())
                {
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.h6" Color="Color.Primary">Character Progress</MudText>
                            <MudDivider Class="mb-4" />
                        </MudItem>

                        <!-- Seção de Gerenciamento de Quest Individual -->
                        <MudItem xs="12">
                            <MudPaper Class="pa-4 mb-6" Elevation="1">
                                <MudStack>
                                    <MudText Typo="Typo.subtitle1" Class="mb-2">Gerenciar Quest</MudText>

                                    <MudTextField @bind-Value="_questIdToUpdate"
                                                  Label="Quest ID"
                                                  Variant="Variant.Outlined"
                                                  InputType="InputType.Number"
                                                  Immediate="true"
                                                  Class="mb-2"
                                                  Style="max-width: 200px;" />

                                    @if (Player.CharacterProgresses.FirstOrDefault() != null && _questIdToUpdate > 0)
                                    {
                                        <MudText Class="mb-2">
                                            Status atual: <MudBadge Color="@(IsQuestCompleted(Player.CharacterProgresses.First(), _questIdToUpdate) ? Color.Success : Color.Error)">
                                                @(IsQuestCompleted(Player.CharacterProgresses.First(), _questIdToUpdate) ? "Completa" : "Incompleta")
                                            </MudBadge>
                                        </MudText>
                                    }

                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Success"
                                                   OnClick="() => { _questCompletionStatus = true; UpdateQuestStatus(); }"
                                                   Disabled="_isUpdatingQuest || _questIdToUpdate <= 0"
                                                   StartIcon="@Icons.Material.Filled.Check"
                                                   Size="Size.Small">
                                            Completar
                                        </MudButton>

                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Error"
                                                   OnClick="() => { _questCompletionStatus = false; UpdateQuestStatus(); }"
                                                   Disabled="_isUpdatingQuest || _questIdToUpdate <= 0"
                                                   StartIcon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small">
                                            Incompletar
                                        </MudButton>
                                    </div>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <!-- Seção Separada: Zerar Todas as Quests -->

                        <MudItem xs="12">
                            <MudPaper Class="pa-4 mb-6" Elevation="1" Style="border: 1px solid #e57373;">
                                <MudStack>
                                    <MudText Typo="Typo.subtitle1" Class="mb-2">Zerar Todas as Quests</MudText>

                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                        Esta ação irá remover todas as quests ativas do jogador.
                                    </MudAlert>

                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Warning"
                                               OnClick="DeleteActiveQuests"
                                               Disabled="_deletingQuests"
                                               StartIcon="@Icons.Material.Filled.DeleteForever"
                                               Size="Size.Small">
                                        Deletar Todas as Quests
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        @foreach (var progress in Player.CharacterProgresses)
                        {
                            <MudItem xs="12" md="6">
                                <MudCard>
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle1" Class="mb-2">Progress ID: @progress.Id</MudText>
                                        <MudText>Character ID: @progress.CharacterId</MudText>

                                        <MudText Typo="Typo.subtitle2" Class="mt-4">Completed Data</MudText>
                                        <MudText>Bytes: @(progress.CompletedData?.Length ?? 0) bytes</MudText>

                                        <MudText Typo="Typo.subtitle2" Class="mt-4">Completed Data Values</MudText>
                                        <MudText>Values: @(progress.CompletedDataValue?.Length ?? 0) values</MudText>

                                        <MudText Typo="Typo.subtitle2" Class="mt-4">Quests in Progress</MudText>
                                        <MudText>Count: @(progress.InProgressQuestData?.Count ?? 0)</MudText>

                                        @if (progress.InProgressQuestData?.Any() == true)
                                        {
                                            <MudTable Items="@progress.InProgressQuestData" Hover="true" Class="mt-4">
                                                <HeaderContent>
                                                    <MudTh>Quest ID</MudTh>
                                                </HeaderContent>
                                                <RowTemplate>
                                                    <MudTd>@context.QuestId</MudTd>
                                                </RowTemplate>
                                            </MudTable>
                                        }
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">
                        No progress data found for this player.
                    </MudAlert>
                }
            </MudTabPanel>






            <!-- Digimon Management Tab -->
            <MudTabPanel Text="Digimons" Icon="@Icons.Material.Filled.Pets">
                @if (Player?.Digimons != null && Player.Digimons.Any())
                {
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_digimonSearch" Label="Pesquisar Digimon pelo nome" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" />
                        </MudItem>
                        @foreach (var digimon in FilteredDigimons)
                        {
                            <MudItem xs="12" sm="6" md="4" lg="3">
                                <MudCard Style="margin-bottom:20px;">
                                    <MudCardContent>
                                        <MudText Typo="Typo.h6">@digimon.Name</MudText>
                                        <MudText>
                                            Level:
                                            <MudNumericField T="byte" @bind-Value="digimon.Level" Min="1" Max="120" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            Current Experience:
                                            <MudNumericField T="long" @bind-Value="digimon.CurrentExperience" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            HP:
                                            <MudNumericField T="int" @bind-Value="digimon.CurrentHp" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            DS:
                                            <MudNumericField T="int" @bind-Value="digimon.CurrentDs" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            CurrentType:
                                            <MudNumericField T="int" @bind-Value="digimon.CurrentType" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            Slot:
                                            <MudNumericField T="byte" @bind-Value="digimon.Slot" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            DigicloneAT:
                                            <MudNumericField T="byte" @bind-Value="digimon.Digiclone.ATLevel" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            DigicloneCT:
                                            <MudNumericField T="byte" @bind-Value="digimon.Digiclone.CTLevel" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            DigicloneBL:
                                            <MudNumericField T="byte" @bind-Value="digimon.Digiclone.BLLevel" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            DigicloneEV:
                                            <MudNumericField T="byte" @bind-Value="digimon.Digiclone.EVLevel" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudText>
                                            DigicloneHP:
                                            <MudNumericField T="byte" @bind-Value="digimon.Digiclone.HPLevel" Min="0" Variant="Variant.Outlined" />
                                        </MudText>
                                        <MudSelect T="DigitalWorldOnline.Commons.Enums.DigimonHatchGradeEnum" @bind-Value="digimon.HatchGrade" Label="Hatch Grade" Variant="Variant.Outlined">
                                            <MudSelectItem Value="DigitalWorldOnline.Commons.Enums.DigimonHatchGradeEnum.Default">Default</MudSelectItem>
                                            <MudSelectItem Value="DigitalWorldOnline.Commons.Enums.DigimonHatchGradeEnum.High">High</MudSelectItem>
                                            <MudSelectItem Value="DigitalWorldOnline.Commons.Enums.DigimonHatchGradeEnum.Perfect">Perfect</MudSelectItem>
                                            <MudSelectItem Value="DigitalWorldOnline.Commons.Enums.DigimonHatchGradeEnum.Transcend">Transcend</MudSelectItem>
                                        </MudSelect>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   OnClick="SaveDigimons"
                                                   Disabled="@Saving">
                                            @if (Saving)
                                            {
                                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                <MudText Class="ms-2">Salvando...</MudText>
                                            }
                                            else
                                            {
                                                <MudText>Salvar Alterações</MudText>
                                            }
                                        </MudButton>
                                    </MudCardContent>
                                    <MudCardActions>
                                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => RemoveDigimon(digimon))">Remove</MudButton>
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewDigimon">Add New Digimon</MudButton>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex justify-end">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="SaveDigimons"
                                       Disabled="@Saving">
                                @if (Saving)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Salvando...</MudText>
                                }
                                else
                                {
                                    <MudText>Salvar Alterações</MudText>
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">No Digimons found for this player.</MudAlert>
                }
            </MudTabPanel>

            @code {
        private string _digimonSearch = string.Empty;

            private IEnumerable<DigimonDTO> FilteredDigimons =>
            string.IsNullOrWhiteSpace(_digimonSearch)
            ? Player.Digimons
            .OrderBy(d => d.Slot == 255 ? 1 : 0)
            .ThenBy(d => d.Slot == 255 ? 0 : d.Slot)
            : Player.Digimons
            .Where(d => d.Name != null && d.Name.Contains(_digimonSearch, StringComparison.OrdinalIgnoreCase))
            .OrderBy(d => d.Slot == 255 ? 1 : 0)
            .ThenBy(d => d.Slot == 255 ? 0 : d.Slot);
            }

        </MudTabs>
    </Loader>
</MudPaper>
