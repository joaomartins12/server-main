@using MudBlazor

<MudNavMenu Class="navmenu-dark">

    <!-- Dashboard -->
    <MudText Typo="Typo.subtitle2" Class="mt-4 ml-2 section-title" Color="Color.Primary">Dashboard</MudText>
    <MudNavGroup Icon="@Icons.Material.Filled.Dashboard" Dense="true" Expanded="true">
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Overview</MudNavLink>
        <AuthorizeView>
            <MudNavLink Href="/downloads" Icon="@Icons.Material.Filled.Download">Downloads</MudNavLink>
        </AuthorizeView>
    </MudNavGroup>

    <!-- Player Management -->
    <AuthorizeView Roles="Administrator,GameMaster">
        <Authorized>
            <MudText Typo="Typo.subtitle2" Class="mt-4 ml-2 section-title" Color="Color.Primary">Contas e tamers</MudText>
            <MudNavGroup Icon="@Icons.Material.Filled.People" Dense="true">
                <MudNavLink Href="/players" Icon="@Icons.Material.Filled.Person">Players</MudNavLink>
                <MudNavLink Href="/accounts" Icon="@Icons.Material.Filled.AccountBox">Game Accounts</MudNavLink>
                <MudNavLink Href="/users" Icon="@Icons.Material.Filled.ManageAccounts">Admin Users</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Game Content -->
    <AuthorizeView Roles="Administrator,GameMaster">
        <Authorized>
            <MudText Typo="Typo.subtitle2" Class="mt-4 ml-2 section-title" Color="Color.Primary">Recursos do jogo</MudText>
            <MudNavGroup Icon="@Icons.Material.Filled.Extension" Dense="true">
                <MudNavLink Href="/mobs" Icon="@Icons.Material.Filled.Pets">Mobs</MudNavLink>
                <MudNavLink Href="/hatchs" Icon="@Icons.Material.Filled.Egg">Hatching</MudNavLink>
                <MudNavLink Href="/clones" Icon="@Icons.Material.Filled.ContentCopy">Clones</MudNavLink>
                <MudNavLink Href="/containers" Icon="@Icons.Material.Filled.Inventory">Containers</MudNavLink>
                <MudNavLink Href="/scans" Icon="@Icons.Material.Filled.Scanner">Scans</MudNavLink>
                <MudNavLink Href="/raids" Icon="@Icons.Material.Filled.Group">Raids</MudNavLink>
                <MudNavLink Href="/globaldrops" Icon="@Icons.Material.Filled.CardGiftcard">Global Drops</MudNavLink>
                <MudNavLink Href="/spawnpoints" Icon="@Icons.Material.Filled.Place">Spawn Points</MudNavLink>
                <MudNavLink Href="/summonmobs" Icon="@Icons.Material.Filled.BugReport">Summon Mobs</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Game Tools -->
    <AuthorizeView Roles="Administrator,GameMaster">
        <Authorized>
            <MudText Typo="Typo.subtitle2" Class="mt-4 ml-2 section-title" Color="Color.Primary">Game Tools</MudText>
            <MudNavGroup Icon="@Icons.Material.Filled.Build" Dense="true">
                <MudNavLink Href="/mobs" Icon="@Icons.Material.Filled.Pets">Mobs</MudNavLink>
                <MudNavLink Href="/hatchs" Icon="@Icons.Material.Filled.Egg">Hatching</MudNavLink>
                <MudNavLink Href="/clones" Icon="@Icons.Material.Filled.ContentCopy">Clones</MudNavLink>
                <MudNavLink Href="/raids" Icon="@Icons.Material.Filled.Group">Raids</MudNavLink>
                <MudNavLink Href="/maps" Icon="@Icons.Material.Filled.Map">Maps</MudNavLink>
                <MudNavLink Href="/globaldrops" Icon="@Icons.Material.Filled.CardGiftcard">Global Drops</MudNavLink>
                <MudNavLink Href="/machines" Icon="@Icons.Material.Filled.Casino">Machines</MudNavLink>
                <MudNavLink Href="/spawnpoints" Icon="@Icons.Material.Filled.Place">Spawn Points</MudNavLink>
                <MudNavLink Href="/summonmobs" Icon="@Icons.Material.Filled.BugReport">Summon Mobs</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- System Settings -->
    <AuthorizeView Roles="Administrator">
        <Authorized>
            <MudText Typo="Typo.subtitle2" Class="mt-4 ml-2 section-title" Color="Color.Primary">System Settings</MudText>
            <MudNavGroup Icon="@Icons.Material.Filled.Settings" Dense="true">
                <MudNavLink Href="/servers" Icon="@Icons.Material.Filled.Dns">Servers</MudNavLink>
                <MudNavLink Href="/logs" Icon="@Icons.Material.Filled.Description">Logs</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

</MudNavMenu>

<style>
    /* Fundo do menu um toque MAIS ESCURO que o Drawer do tema (#0B1220) */
    .navmenu-dark {
        background-color: #0A0F1A;
        min-height: 100%;
        padding-bottom: 12px;
    }

        /* títulos das secções: ligeiro destaque e espaçamento */
        .navmenu-dark .section-title {
            letter-spacing: .2px;
            opacity: .95;
        }

        /* links/grupos com cantos arredondados para não “colar” ao fundo */
        .navmenu-dark .mud-nav-group,
        .navmenu-dark .mud-nav-link {
            border-radius: 8px;
        }

            /* hover/seleção com tom ainda mais escuro para feedback */
            .navmenu-dark .mud-nav-link:hover,
            .navmenu-dark .mud-nav-link.mud-selected {
                background-color: #111a2a;
            }

        /* opcional: separar blocos com uma linha subtil */
        .navmenu-dark .mud-nav-group {
            margin: 4px 6px;
        }
</style>
