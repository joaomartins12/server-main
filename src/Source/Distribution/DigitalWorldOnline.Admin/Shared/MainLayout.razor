@using Microsoft.AspNetCore.WebUtilities
@using MudBlazor
@inherits LayoutComponentBase
@inject NavigationManager navMan

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudDialogProvider />
<MudSnackbarProvider />

@if (navMan.Uri.Contains("/downloads"))
{
    <MudLayout>
        <MudAppBar Elevation="3">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            <MudSpacer />
            <MudIconButton Icon="@Icons.Filled.ExitToApp" Title="Logout" Color="Color.Inherit" Href="logout" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="3">
            <MudDrawerHeader>
                <img src="@($"{navMan.BaseUri}Images/dmo_header.png?v=1")"
                     alt="Digital Universe" width="200" style="padding-left: 20px;" />
            </MudDrawerHeader>
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Style="margin-top:40px;">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else
{
    <AuthorizeView>
        <Authorized>
            <MudLayout>
                <MudAppBar Elevation="3">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Filled.ExitToApp" Title="Logout" Color="Color.Inherit" Href="logout" />
                </MudAppBar>

                <MudDrawer @bind-Open="_drawerOpen" Elevation="3">
                    <MudDrawerHeader>
                        <img src="@($"{navMan.BaseUri}Images/dmo_header.png?v=1")"
                             alt="Digital Universe" width="200" style="padding-left: 20px;" />
                    </MudDrawerHeader>
                    <NavMenu />
                </MudDrawer>

                <MudMainContent>
                    <MudContainer MaxWidth="MaxWidth.False" Style="margin-top:40px;">
                        @Body
                    </MudContainer>
                </MudMainContent>
            </MudLayout>
        </Authorized>

        <NotAuthorized>
            <TrackRedirect />
        </NotAuthorized>
    </AuthorizeView>
}

@code
{
    bool _drawerOpen = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    // Tema DARK
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Background = "#121212",
            Surface = "#1E1E1E",
            AppbarBackground = "#0F172A",
            AppbarText = "#E5E7EB",
            DrawerBackground = "#0B1220",
            DrawerText = "#E5E7EB",
            DrawerIcon = "#93C5FD",
            Primary = "#90CAF9",
            Secondary = "#F48FB1",
            Tertiary = "#A5D6A7",
            TextPrimary = "#E5E7EB",
            TextSecondary = "#94A3B8",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#F87171",
            Info = "#60A5FA",
            Divider = "#2A2A2A",
            TableLines = "#2A2A2A"
        }
    };
}
